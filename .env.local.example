# ============================================================
# 假装社区 — 环境变量模板
# 复制此文件为 .env.local 并填入真实值
# ============================================================

# 数据库连接 (PostgreSQL)
# 本地开发可用: postgresql://localhost:5432/jiazhuang
DATABASE_URL="postgresql://user:password@localhost:5432/jiazhuang"

# NextAuth.js 认证
AUTH_SECRET="your-auth-secret-generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"

# OAuth 提供商 (可选)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# 应用配置
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="假装社区"
